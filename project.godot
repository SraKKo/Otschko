; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="blackjack"
run/main_scene="res://Scenes/ProfileGate.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[audio]

buses/default_bus_layout="res://Sounds/default_bus_layout.tres"

[autoload]

Localization="*res://Scripts/Localization.gd"
Global="*res://Scripts/Global.gd"
inventory="*res://Scripts/Inventory.gd"
TrinketDb="*res://Scripts/TrinketDb.gd"
SettingsMenager="*res://Scripts/SettingsManager.gd"
MusicPlayer="*res://Scenes/MusicPlayer.tscn"
SfxPlayer="*res://Scripts/SFXPlayer.gd"
PCRuntime="*res://Scripts/PCRuntime.gd"
ControllerInput="*res://Scripts/ControllerInput.gd"
UserSession="*res://Scripts/UserSession.gd"
RoamingSave="*res://Scripts/RoamingSave.gd"
LicenseService="*res://Scripts/LicenseService.gd"
Achievements="*res://Scripts/Achievements.gd"

[display]

window/size/resizable=false
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"

[input]

pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[internationalization]

locale/translations=PackedStringArray("res://Locale/pl.po", "res://Locale/en.po")
locale/fallback="pl"
pseudolocalization/expansion_ratio=0.25
pseudolocalization/skip_placeholders=true

[rendering]

renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
